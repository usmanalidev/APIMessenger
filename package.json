{
  "name": "api-messenger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c teal,amber \"npm run server\" \"npm run client\"",
    "server": "nodemon --watch server server/index.js",
    "client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "package:share": "node scripts/make-share-package.mjs",
    "preview": "vite preview",
    "lint": "oxlint"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
